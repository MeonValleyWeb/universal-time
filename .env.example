# Canonical site and optional verification
PUBLIC_SITE_URL=https://universaltime.app
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_CF_ANALYTICS_TOKEN=
PUBLIC_PRIVACY_EMAIL=privacy@universaltime.app

# AdSense remains off until the account, ad units and a Google-certified CMP are ready.
PUBLIC_ADSENSE_ENABLED=false
PUBLIC_ADSENSE_CONSENT_READY=false
PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
PUBLIC_ADSENSE_GUIDE_SLOT=
PUBLIC_ADSENSE_CONVERTER_SLOT=
