---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'WorldTime Meeting Planner',
	description = 'Compare working hours across the world on one visual timeline.',
} = Astro.props;
const canonicalUrl = new URL('/meeting-planner', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" data-theme="meridian">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#111a2a" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[var(--color-canvas)] text-[var(--color-ink)] antialiased">
		<SiteHeader />
		<slot />
	</body>
</html>
