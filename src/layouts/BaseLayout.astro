---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
}

const {
	title = 'WorldTime — world time, instantly understood',
	description = 'Convert any time, compare cities and find the right moment to call.',
	canonical,
} = Astro.props;
const socialImage = new URL('/og.png', Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f2efe8" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="WorldTime" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={socialImage} />
		{canonical && <link rel="canonical" href={new URL(canonical, Astro.url)} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Newsreader:opsz,wght@6..72,300;6..72,500&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[#f2efe8] font-[Newsreader] text-stone-950 antialiased selection:bg-orange-600 selection:text-white">
		<slot />
	</body>
</html>
