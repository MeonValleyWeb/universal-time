---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	schema?: Record<string, unknown> | Record<string, unknown>[];
	socialImage?: string;
	adSlot?: string;
}

const {
	title = 'WorldTime — world time, instantly understood',
	description = 'Convert any time, compare cities and find the right moment to call.',
	canonical,
	schema,
	socialImage = '/og/home.png',
	adSlot = '',
} = Astro.props;
const baseUrl = Astro.site ?? Astro.url;
const socialImageUrl = new URL(socialImage, baseUrl);
const canonicalUrl = canonical && Astro.site ? new URL(canonical, Astro.site) : undefined;
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'WorldTime',
	url: new URL('/', baseUrl).toString(),
	description: 'Convert any time, compare cities and find the right moment to call.',
	potentialAction: {
		'@type': 'SearchAction',
		target: `${new URL('/', baseUrl).toString()}?q={search_term_string}`,
		'query-input': 'required name=search_term_string',
	},
};
const structuredData = schema
	? [websiteSchema, ...(Array.isArray(schema) ? schema : [schema])]
	: [websiteSchema];
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT?.trim() ?? '';
const adsenseEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true';
const adsenseConsentReady = import.meta.env.PUBLIC_ADSENSE_CONSENT_READY === 'true';
const adsensePageReady =
	adsenseEnabled
	&& adsenseConsentReady
	&& /^ca-pub-\d+$/.test(adsenseClient)
	&& /^\d+$/.test(adSlot);
---

<!doctype html>
<html lang="en" data-theme="meridian">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow,max-image-preview:large" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#111a2a" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="WorldTime" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={socialImageUrl} />
		{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
		{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
		{/^ca-pub-\d+$/.test(adsenseClient) && <meta name="google-adsense-account" content={adsenseClient} />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/json" />
		<link rel="service-desc" href="/openapi.json" type="application/vnd.oai.openapi+json;version=3.1" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{adsensePageReady && (
			<script
				is:inline
				async
				crossorigin="anonymous"
				src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
			></script>
		)}
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[var(--color-canvas)] text-[var(--color-ink)] antialiased">
		<SiteHeader />
		<slot />
		<footer class="border-t border-[var(--color-line)] px-4 py-7 sm:px-6">
			<div class="mx-auto flex max-w-[1180px] flex-col gap-5 text-sm text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between">
				<p><span class="font-serif text-lg text-[var(--color-ink)]">WorldTime</span> · Time zones, without the mental overhead.</p>
				<nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal and information">
					<a href="/astronomy" class="hover:text-[var(--color-signal)]">Sun & Moon</a>
					<a href="/guides" class="hover:text-[var(--color-signal)]">How time works</a>
					<a href="/privacy" class="hover:text-[var(--color-signal)]">Privacy & cookies</a>
				</nav>
			</div>
		</footer>
		{cloudflareAnalyticsToken && (
			<script
				is:inline
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}
			></script>
		)}
		<script is:inline>
			{`(() => {
				const modelContext = document.modelContext || navigator.modelContext;
				if (!modelContext || typeof modelContext.registerTool !== 'function') return;

				const controller = new AbortController();
				window.addEventListener('pagehide', () => controller.abort(), { once: true });
				void modelContext.registerTool({
					name: 'open-time-converter',
					title: 'Open a WorldTime city converter',
					description: 'Returns a WorldTime converter URL for two lowercase city slugs. This is a read-only navigation tool.',
					inputSchema: {
						type: 'object',
						properties: {
							from: { type: 'string', description: 'Source city slug, for example london.' },
							to: { type: 'string', description: 'Destination city slug, for example new-york.' },
						},
						required: ['from', 'to'],
						additionalProperties: false,
					},
					annotations: { readOnlyHint: true },
					execute: ({ from, to }) => {
						const source = typeof from === 'string' ? from.trim().toLowerCase() : '';
						const destination = typeof to === 'string' ? to.trim().toLowerCase() : '';
						if (!/^[a-z0-9-]+$/.test(source) || !/^[a-z0-9-]+$/.test(destination)) {
							throw new TypeError('City slugs must contain lowercase letters, digits or hyphens.');
						}
						return { url: new URL('/convert/' + source + '/' + destination, location.origin).toString() };
					},
				}, { signal: controller.signal }).catch(() => undefined);
			})();`}
		</script>
	</body>
</html>
