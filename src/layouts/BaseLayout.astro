---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	schema?: Record<string, unknown> | Record<string, unknown>[];
	adSlot?: string;
}

const {
	title = 'WorldTime — world time, instantly understood',
	description = 'Convert any time, compare cities and find the right moment to call.',
	canonical,
	schema,
	adSlot = '',
} = Astro.props;
const baseUrl = Astro.site ?? Astro.url;
const socialImage = new URL('/og.png', baseUrl);
const canonicalUrl = canonical && Astro.site ? new URL(canonical, Astro.site) : undefined;
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'WorldTime',
	url: new URL('/', baseUrl).toString(),
	description: 'Convert any time, compare cities and find the right moment to call.',
	potentialAction: {
		'@type': 'SearchAction',
		target: `${new URL('/', baseUrl).toString()}?q={search_term_string}`,
		'query-input': 'required name=search_term_string',
	},
};
const structuredData = schema
	? [websiteSchema, ...(Array.isArray(schema) ? schema : [schema])]
	: [websiteSchema];
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT?.trim() ?? '';
const adsenseEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true';
const adsenseConsentReady = import.meta.env.PUBLIC_ADSENSE_CONSENT_READY === 'true';
const adsensePageReady =
	adsenseEnabled
	&& adsenseConsentReady
	&& /^ca-pub-\d+$/.test(adsenseClient)
	&& /^\d+$/.test(adSlot);
---

<!doctype html>
<html lang="en" data-theme="paper" data-theme-preference="auto">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			try {
				const saved = localStorage.getItem('worldtime:theme');
				const preference = ['auto', 'paper', 'dark'].includes(saved) ? saved : 'auto';
				const hour = new Date().getHours();
				const theme = preference === 'auto' ? (hour >= 7 && hour < 19 ? 'paper' : 'dark') : preference;
				document.documentElement.dataset.theme = theme;
				document.documentElement.dataset.themePreference = preference;
			} catch {}
		</script>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f2efe8" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="WorldTime" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={socialImage} />
		{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
		{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
		{/^ca-pub-\d+$/.test(adsenseClient) && <meta name="google-adsense-account" content={adsenseClient} />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Newsreader:opsz,wght@6..72,300;6..72,500&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
		{adsensePageReady && (
			<script
				is:inline
				async
				crossorigin="anonymous"
				src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
			></script>
		)}
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[var(--color-canvas)] font-[Newsreader] text-[var(--color-ink)] antialiased selection:bg-[var(--color-signal)] selection:text-[var(--color-signal-ink)]">
		<slot />
		<footer class="border-t border-[var(--color-line)] px-5 py-8 sm:px-8">
			<div class="mx-auto flex max-w-[1500px] flex-col gap-5 text-sm text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between">
				<p><span class="text-[var(--color-ink)]">WorldTime</span> · Built around UTC, not around you.</p>
				<nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal and information">
					<a href="/guides" class="hover:text-[var(--color-signal)]">How time works</a>
					<a href="/privacy" class="hover:text-[var(--color-signal)]">Privacy & cookies</a>
				</nav>
			</div>
		</footer>
		<ThemeSwitcher client:load />
		{cloudflareAnalyticsToken && (
			<script
				is:inline
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}
			></script>
		)}
	</body>
</html>
