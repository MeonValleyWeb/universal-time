---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = 'WorldTime — world time, instantly understood',
	description = 'Convert any time, compare cities and find the right moment to call.',
	canonical,
	schema,
} = Astro.props;
const baseUrl = Astro.site ?? Astro.url;
const socialImage = new URL('/og.png', baseUrl);
const canonicalUrl = canonical && Astro.site ? new URL(canonical, Astro.site) : undefined;
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'WorldTime',
	url: new URL('/', baseUrl).toString(),
	description: 'Convert any time, compare cities and find the right moment to call.',
	potentialAction: {
		'@type': 'SearchAction',
		target: `${new URL('/', baseUrl).toString()}?q={search_term_string}`,
		'query-input': 'required name=search_term_string',
	},
};
const structuredData = schema
	? [websiteSchema, ...(Array.isArray(schema) ? schema : [schema])]
	: [websiteSchema];
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f2efe8" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="WorldTime" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={socialImage} />
		{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
		{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Newsreader:opsz,wght@6..72,300;6..72,500&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[#f2efe8] font-[Newsreader] text-stone-950 antialiased selection:bg-orange-600 selection:text-white">
		<slot />
		{cloudflareAnalyticsToken && (
			<script
				is:inline
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}
			></script>
		)}
	</body>
</html>
