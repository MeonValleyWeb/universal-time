---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimeZoneExplorer from '../components/TimeZoneExplorer';

const initialNow = Date.now();
---

<BaseLayout
	title="Time zone explorer · WorldTime"
	description="Explore current time zones around the world. Compare live local time, dates, UTC offsets and seasonal clock rules from your browser’s location."
	canonical="/time-zones"
>
	<header class="border-b border-[var(--color-line)] px-5 sm:px-8">
		<div class="mx-auto flex h-20 max-w-[1500px] items-center justify-between">
			<a href="/" class="flex items-center gap-3"><span class="grid size-9 place-items-center rounded-full bg-[var(--color-signal)] font-serif text-xl italic text-[var(--color-signal-ink)]">W</span><span class="font-serif text-xl">WorldTime</span></a>
			<a href="/guides/how-time-zones-work" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)]">How zones work →</a>
		</div>
	</header>
	<main>
		<section class="atlas-hero relative overflow-hidden border-b border-[var(--color-line)] px-5 py-16 sm:px-8 lg:py-20">
			<img src="/world-atlas-bg.webp" alt="" class="pointer-events-none absolute inset-0 size-full object-cover opacity-45" aria-hidden="true" />
			<div class="atlas-wash pointer-events-none absolute inset-0 bg-gradient-to-r from-[var(--color-canvas)] via-[var(--color-canvas)]/75 to-transparent" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-[1500px]"><p class="font-mono text-[10px] uppercase tracking-[0.24em] text-[var(--color-signal)]">The civil-time map</p><h1 class="mt-5 max-w-4xl font-serif text-[clamp(3.8rem,8vw,8rem)] leading-[0.9] tracking-[-0.065em]">The world is<br /><em class="font-normal text-[var(--color-signal)]">not on one clock.</em></h1><p class="mt-7 max-w-xl text-base leading-7 text-[var(--color-muted)]">Start from where you are. See the time, date and rule that apply everywhere else.</p></div>
		</section>
		<section class="px-5 py-12 sm:px-8 lg:py-16"><div class="mx-auto max-w-[1500px]"><TimeZoneExplorer client:load initialNow={initialNow} /></div></section>
		<section class="border-t border-[var(--color-line)] px-5 py-14 sm:px-8"><div class="mx-auto grid max-w-[1500px] gap-8 lg:grid-cols-3"><div class="lg:col-span-2"><h2 class="font-serif text-4xl tracking-[-0.045em]">An offset is only today’s answer.</h2><p class="mt-4 max-w-2xl text-base leading-7 text-[var(--color-muted)]">For a future meeting, use a named time zone such as Europe/London or America/New_York. It includes the rule history that makes daylight-saving changes and political decisions computable.</p></div><a href="/meeting-planner" class="self-start border-b border-[var(--color-ink)] pb-3 font-mono text-[10px] uppercase tracking-[0.16em] hover:border-[var(--color-signal)] hover:text-[var(--color-signal)]">Find a fair meeting time →</a></div></section>
	</main>
</BaseLayout>
