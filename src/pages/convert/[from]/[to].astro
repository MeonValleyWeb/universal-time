---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import NaturalTime from '../../../components/NaturalTime';
import CityClock from '../../../components/CityClock';
import { cities, converterPairs, type City } from '../../../lib/cities';
import { getPairContext } from '../../../lib/search-context';

export function getStaticPaths() {
	return converterPairs.map((pair) => ({
		params: { from: pair.from, to: pair.to },
		props: {
			from: cities.find((city) => city.slug === pair.from)!,
			to: cities.find((city) => city.slug === pair.to)!,
			reason: pair.reason,
		},
	}));
}

interface Props { from: City; to: City; reason: string }
const { from, to, reason } = Astro.props;
const converterAdSlot = import.meta.env.PUBLIC_ADSENSE_CONVERTER_SLOT?.trim() ?? '';
const initialNow = Date.now();
const initialQuery = `9am ${from.name} in ${to.name}`;
const context = getPairContext(from, to, initialNow);
const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: `${from.name} to ${to.name} time converter`,
	description: `Convert ${from.name} time to ${to.name} and find a good time to call.`,
};
---

<BaseLayout
	title={`${from.name} to ${to.name} time converter · WorldTime`}
	description={`Convert ${from.name} time to ${to.name}. See the current time difference and choose a good time to call.`}
	canonical={`/convert/${from.slug}/${to.slug}`}
	schema={schema}
	adSlot={converterAdSlot}
>
	<main class="px-5 py-14 sm:px-8 lg:py-20">
		<div class="mx-auto max-w-[1500px]">
			<p class="font-mono text-[10px] uppercase tracking-[0.2em] text-orange-700">Time converter</p>
			<h1 class="mt-3 max-w-5xl font-serif text-5xl leading-[0.95] tracking-[-0.055em] sm:text-7xl">
				{from.name} <span class="text-stone-400">to</span> {to.name}
			</h1>
			<div class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-stone-300 bg-stone-300 lg:grid-cols-2">
				<div class="bg-[#e8e4dc] p-8 sm:p-10">
					<p class="font-mono text-[10px] uppercase tracking-wider text-stone-500">{from.country}</p>
					<h2 class="mt-2 font-serif text-3xl">{from.name}</h2>
					<div class="mt-8"><CityClock client:load zone={from.zone} initialNow={initialNow} /></div>
				</div>
				<div class="bg-stone-950 p-8 text-white sm:p-10">
					<p class="font-mono text-[10px] uppercase tracking-wider text-stone-400">{to.country}</p>
					<h2 class="mt-2 font-serif text-3xl">{to.name}</h2>
					<div class="mt-8"><CityClock client:load zone={to.zone} initialNow={initialNow} /></div>
				</div>
			</div>
			<div class="mt-12">
				<NaturalTime client:load initialNow={initialNow} initialQuery={initialQuery} />
			</div>

			<section class="mt-16 border-t border-[var(--color-line)] pt-12">
				<div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-signal)]">Working together</p>
						<h2 class="mt-3 font-serif text-4xl tracking-[-0.04em]">The useful part of the difference</h2>
						<p class="mt-5 max-w-md text-sm leading-6 text-[var(--color-muted)]">{reason}</p>
					</div>
					<div class="grid gap-px bg-[var(--color-line)] sm:grid-cols-2">
						<article class="bg-[var(--color-surface)] p-6">
							<p class="font-mono text-[9px] uppercase tracking-[0.18em] text-[var(--color-subtle)]">Working-hour overlap</p>
							<h3 class="mt-5 font-serif text-2xl">When both cities are at work</h3>
							<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{context.overlapSummary}</p>
						</article>
						<article class="bg-[var(--color-surface)] p-6">
							<p class="font-mono text-[9px] uppercase tracking-[0.18em] text-[var(--color-subtle)]">Calendar boundary</p>
							<h3 class="mt-5 font-serif text-2xl">Check the date, not just the hour</h3>
							<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{context.dateSummary}</p>
						</article>
						<article class="bg-[var(--color-surface)] p-6 sm:col-span-2">
							<p class="font-mono text-[9px] uppercase tracking-[0.18em] text-[var(--color-subtle)]">Daylight saving time</p>
							<h3 class="mt-5 font-serif text-2xl">The gap can move during the year</h3>
							<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{context.dstSummary}</p>
						</article>
					</div>
				</div>
			</section>

			<AdSlot slotId={converterAdSlot} placement="converter-after-context" minHeight={140} />
		</div>
	</main>
</BaseLayout>
