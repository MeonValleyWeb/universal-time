---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalSkyTimes from '../components/LocalSkyTimes';
import SkyCountdowns from '../components/SkyCountdowns';

const initialNow = Date.now();
---

<BaseLayout
	title="Sun, Moon and celestial event times · WorldTime"
	description="Calculate local sunrise, sunset, solar noon, moonrise, moonset and lunar phase, then count down to major eclipses and comet-linked sky events."
	canonical="/astronomy"
>
	<main>
		<section class="atlas-hero relative overflow-hidden border-b border-[var(--color-line)] px-5 py-16 sm:px-8 lg:py-24">
			<img src="/world-atlas-bg.webp" alt="" class="pointer-events-none absolute inset-0 size-full object-cover opacity-50" aria-hidden="true" />
			<div class="atlas-wash pointer-events-none absolute inset-0 bg-gradient-to-r from-[#f6f0e4]/95 via-[#f6f0e4]/65 to-transparent" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-[1180px]">
				<p class="font-mono text-[10px] uppercase tracking-[0.24em] text-[var(--color-signal)]">Astronomical time</p>
				<h1 class="mt-5 max-w-5xl font-serif text-[clamp(4rem,9vw,9rem)] leading-[0.84] tracking-[-0.065em]">
					The sky keeps<br /><em class="font-normal text-[var(--color-signal)]">its own clock.</em>
				</h1>
				<p class="mt-8 max-w-xl text-base leading-7 text-[var(--color-muted)]">
					Sunlight, moonlight, eclipses and comet trails are all questions of time and place. No weather forecast—just the moments.
				</p>
			</div>
		</section>

		<section class="px-5 py-16 sm:px-8">
			<div class="mx-auto max-w-[1180px]">
				<LocalSkyTimes client:load />
			</div>
		</section>

		<section class="border-y border-[var(--color-line)] bg-[var(--color-surface)] px-5 py-16 sm:px-8">
			<div class="mx-auto max-w-[1180px]">
				<p class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-signal)]">What happens next</p>
				<div class="mt-3 flex flex-wrap items-end justify-between gap-5">
					<h2 class="max-w-3xl font-serif text-5xl leading-none tracking-[-0.045em]">Celestial countdowns</h2>
					<p class="max-w-md text-sm leading-6 text-[var(--color-muted)]">Times use authoritative NASA and GSFC event data. Visibility still depends on geography and viewing conditions.</p>
				</div>
				<div class="mt-10"><SkyCountdowns client:load initialNow={initialNow} /></div>
			</div>
		</section>

		<section class="px-5 py-14 sm:px-8">
			<div class="mx-auto max-w-[1180px] border border-[var(--color-line)] p-7 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-10">
				<div><p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-signal)]">Built for the long view</p><h2 class="mt-4 font-serif text-4xl tracking-[-0.04em]">More than a countdown.</h2><p class="mt-3 max-w-2xl text-sm leading-6 text-[var(--color-muted)]">Each listed event has a short guide explaining its global moment, local meaning and original source.</p></div>
				<a href="/astronomy/september-equinox-2026" class="mt-6 inline-flex whitespace-nowrap border-b border-[var(--color-ink)] pb-1 text-sm text-[var(--color-ink)] hover:border-[var(--color-signal)] hover:text-[var(--color-signal)] sm:mt-0">Explore the next season →</a>
			</div>
		</section>
	</main>
</BaseLayout>
