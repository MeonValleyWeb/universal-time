---
import PlannerLayout from '../layouts/PlannerLayout.astro';
import TimeCanvas from '../components/TimeCanvas';

const initialNow = Date.now();
---

<PlannerLayout
	title="World Time Meeting Planner · WorldTime"
	description="Compare working hours across cities and find the fairest meeting time on one visual 48-hour timeline."
>
	<div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
		<img src="/world-atlas-bg.webp" alt="" class="absolute inset-0 size-full object-cover object-top opacity-30" />
		<div class="atlas-wash absolute inset-0 bg-gradient-to-b from-[var(--color-canvas)]/65 via-[var(--color-canvas)]/92 to-[var(--color-canvas)]"></div>
	</div>

	<header class="relative z-10 border-b border-[var(--color-line)] px-5 sm:px-8">
		<div class="mx-auto flex h-[72px] max-w-[96rem] items-center justify-between">
			<a href="/" class="flex items-center gap-3 text-[var(--color-ink)]">
				<span class="grid size-9 place-items-center rounded-full bg-[var(--color-signal)] font-serif text-xl italic text-[var(--color-signal-ink)]">W</span>
				<span class="font-serif text-xl tracking-[-0.03em]">WorldTime</span>
			</a>
			<a href="/" class="border-b border-[var(--color-ink)] pb-1 text-sm text-[var(--color-ink)] hover:border-[var(--color-signal)] hover:text-[var(--color-signal)]">
				Quick converter
			</a>
		</div>
	</header>

	<main class="relative z-10 mx-auto max-w-[96rem] px-3 pb-20 sm:px-6 lg:px-10">
		<section class="grid gap-6 px-2 pb-10 pt-10 sm:px-3 sm:pb-12 sm:pt-14 lg:grid-cols-[1.2fr_0.8fr] lg:items-end lg:gap-16">
			<div>
				<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-signal)]">Global meeting planner</p>
				<h1 class="mt-4 max-w-5xl text-6xl font-light leading-[0.82] tracking-[-0.055em] text-[var(--color-ink)] sm:text-8xl lg:text-[7.5rem]">
					Every hour,<br /><em class="font-light text-[var(--color-signal)]">everywhere.</em>
				</h1>
			</div>
			<p class="max-w-md text-lg leading-8 text-[var(--color-muted)] lg:pb-2">
				Add cities, move across 48 hours and choose the fairest moment for everyone.
			</p>
		</section>

		<TimeCanvas client:load initialNow={initialNow} />
	</main>
</PlannerLayout>
