---
import PlannerLayout from '../layouts/PlannerLayout.astro';
import TimeCanvas from '../components/TimeCanvas';

const initialNow = Date.now();
---

<PlannerLayout
	title="World Time Meeting Planner · WorldTime"
	description="Compare working hours across cities and find the fairest meeting time on one visual 48-hour timeline."
>
	<main class="relative z-10 mx-auto max-w-[1180px] px-4 pb-24 sm:px-6">
		<section class="grid items-end gap-8 pb-11 pt-14 sm:pb-14 sm:pt-16 lg:grid-cols-[0.94fr_1.06fr] lg:gap-[72px] lg:pt-20">
			<div>
				<p class="meridian-eyebrow">
					A fairer window
				</p>
				<h1 class="mt-4 max-w-[620px] font-serif text-[clamp(3.1rem,6vw,4.875rem)] font-medium leading-[0.96] tracking-[-0.06em] text-[var(--color-ink)]">
					Find the overlap, not the compromise.
				</h1>
			</div>
			<div class="max-w-[470px] border-l border-[var(--color-accent)] pl-5 lg:mb-3 lg:justify-self-end">
				<p class="text-[19px] leading-[1.55] text-[var(--color-muted)]">Choose your places and see the working day across every one. The highlighted hours reveal a mutual moment—not someone’s midnight.</p>
				<p class="mt-3 font-mono text-[10px] leading-5 tracking-wide text-[var(--color-muted)]">Drag the timeline · Tap any hour · Add any IANA time zone</p>
			</div>
		</section>

		<TimeCanvas client:load initialNow={initialNow} />
	</main>
</PlannerLayout>
