---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityClock from '../../components/CityClock';
import CityTimeDetails, { CitySeasonalContext } from '../../components/CityTimeDetails';
import { cities, converterPairs, type City } from '../../lib/cities';
import { countryTimeGuideByEntryCity } from '../../lib/country-times';
import { cityTimeContextBySlug } from '../../lib/city-time-context';

export function getStaticPaths() {
	return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

interface Props { city: City }
const { city } = Astro.props;
const comparisons = converterPairs
	.filter((pair) => pair.from === city.slug)
	.map((pair) => cities.find((item) => item.slug === pair.to)!)
	.filter(Boolean);
const countryGuide = countryTimeGuideByEntryCity(city.slug);
const cityContext = cityTimeContextBySlug(city.slug);
const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: `Current time in ${city.name}, ${city.country}`,
	description: city.description,
	about: {
		'@type': 'Place',
		name: city.name,
		address: { '@type': 'PostalAddress', addressCountry: city.country },
	},
};
---

<BaseLayout
	title={`${cityContext?.title ?? `${city.name} time now: current local time in ${city.country}`} · WorldTime`}
	description={cityContext?.description ?? `Current time in ${city.name}, ${city.country}: live clock, local date, ${city.zone}, and today’s UTC offset. Compare ${city.name} with cities around the world.`}
	canonical={`/time/${city.slug}`}
	schema={schema}
>
	<main>
		<section class="px-5 py-16 sm:px-8 lg:py-24">
			<div class="mx-auto max-w-[1180px]">
				<p class="font-sans text-[10px] normal-case tracking-[0.18em] text-orange-700">World / {city.country} / {city.name}</p>
				<div class="mt-10 grid gap-14 lg:grid-cols-[1.35fr_.65fr]">
					<div>
						<p class="font-sans text-[11px] normal-case tracking-[0.2em] text-stone-500">Current time in</p>
						<h1 class="mt-2 font-serif text-6xl leading-none tracking-[-0.06em] sm:text-8xl">{city.name}</h1>
						<div class="mt-12"><CityClock client:load zone={city.zone} /></div>
					</div>
					<aside class="flex flex-col justify-end border-l border-stone-300 pl-6 lg:pl-10">
						<img src="/meridian-mark.svg" alt="" width="72" height="72" class="mb-8 size-[72px]" />
						<p class="font-serif text-2xl leading-snug">{city.description}</p>
						<CityTimeDetails client:load city={city} />
					</aside>
				</div>
			</div>
		</section>

		<section class="border-y border-stone-300 bg-[#e8e4dc] px-5 py-16 sm:px-8">
			<div class="mx-auto max-w-[1180px]">
				<p class="font-sans text-[10px] normal-case tracking-[0.2em] text-stone-500">Compare {city.name}</p>
				<h2 class="mt-2 font-serif text-4xl tracking-[-0.04em]">Where do you need to be?</h2>
				{comparisons.length ? (
					<div class="mt-8 grid border-l border-t border-stone-300 sm:grid-cols-2 lg:grid-cols-3">
						{comparisons.slice(0, 6).map((target) => (
						<a href={`/convert/${city.slug}/${target.slug}`} class="group border-b border-r border-stone-300 p-6 hover:bg-stone-950 hover:text-white">
							<span class="font-sans text-[10px] normal-case tracking-wider text-stone-500">Convert to</span>
							<p class="mt-8 font-serif text-3xl">{target.name}</p>
							<p class="mt-1 text-sm text-stone-500 group-hover:text-stone-400">{target.country} →</p>
						</a>
						))}
					</div>
				) : (
					<a href="/meeting-planner" class="mt-8 inline-flex min-h-11 items-center rounded-[var(--radius-button)] bg-[var(--color-accent)] px-5 text-sm font-medium text-[var(--color-signal-ink)] hover:-translate-y-px hover:brightness-110">
						Compare {city.name} in the meeting planner →
					</a>
				)}
				{comparisons.length > 6 && (
					<details class="mt-6 border-y border-stone-300 py-4">
						<summary class="min-h-11 cursor-pointer text-sm font-medium">More conversions from {city.name} ({comparisons.length - 6})</summary>
						<ul class="mt-3 grid gap-x-6 sm:grid-cols-2 lg:grid-cols-3">
							{comparisons.slice(6).map((target) => (
								<li><a href={`/convert/${city.slug}/${target.slug}`} class="block border-t border-stone-300 py-3 text-sm underline underline-offset-4 hover:text-[var(--color-accent)]">{city.name} to {target.name} →</a></li>
							))}
						</ul>
					</details>
				)}
			</div>
		</section>

		<section class="px-5 py-16 sm:px-8">
			<div class="mx-auto grid max-w-[1180px] gap-10 lg:grid-cols-[.7fr_1.3fr]">
				<div>
					<p class="font-sans text-[10px] normal-case tracking-[0.2em] text-orange-700">Useful context</p>
					<h2 class="mt-3 font-serif text-4xl tracking-[-0.04em]">Understanding {city.name} time</h2>
				</div>
				<div class="grid gap-px bg-stone-300 sm:grid-cols-2">
					<article class="bg-[#f2efe8] p-6">
						<h3 class="font-serif text-2xl">What time zone is {city.name} in?</h3>
						<p class="mt-3 text-sm leading-6 text-stone-600">{city.name} uses the IANA time zone <strong>{city.zone}</strong>. The live clock above shows its current abbreviation and UTC offset.</p>
					</article>
					<article class="bg-[#f2efe8] p-6">
						<h3 class="font-serif text-2xl">When is a good time to call?</h3>
						<p class="mt-3 text-sm leading-6 text-stone-600">Aim for 09:00–17:00 in {city.name}. Open a converter above to see how that working window lands in another city.</p>
					</article>
					<article class="bg-[#f2efe8] p-6 sm:col-span-2">
						<h3 class="font-serif text-2xl">Does {city.name} change its clocks?</h3>
						<CitySeasonalContext client:load city={city} />
					</article>
					{cityContext && (
						<article class="bg-[#f2efe8] p-6 sm:col-span-2">
							<h3 class="font-serif text-2xl">{cityContext.heading}</h3>
							<p class="mt-3 text-sm leading-6 text-stone-600">{cityContext.body}</p>
							<a href={cityContext.related.href} class="mt-4 inline-flex border-b border-[var(--color-accent)] pb-1 text-sm text-[var(--color-accent)] hover:text-[var(--color-ink)]">{cityContext.related.label}</a>
						</article>
					)}
					{countryGuide && (
						<article class="bg-[#f2efe8] p-6 sm:col-span-2">
							<h3 class="font-serif text-2xl">{countryGuide.name} has {countryGuide.zones.length} time zones</h3>
							<p class="mt-3 text-sm leading-6 text-stone-600">{countryGuide.summary}</p>
							<a href={`/time/${countryGuide.slug}`} class="mt-4 inline-flex border-b border-[var(--color-accent)] pb-1 text-sm text-[var(--color-accent)] hover:text-[var(--color-ink)]">See every {countryGuide.name} clock →</a>
						</article>
					)}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
