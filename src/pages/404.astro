---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="That moment cannot be found · WorldTime"
	description="This WorldTime page does not exist. Ask a time question, compare cities, or explore the knowledge of time."
>
	<header class="border-b border-[var(--color-line)] px-5 sm:px-8">
		<div class="mx-auto flex h-20 max-w-[1500px] items-center justify-between">
			<a href="/" class="flex items-center gap-3">
				<span class="grid size-9 place-items-center rounded-full bg-[var(--color-signal)] font-serif text-xl italic text-[var(--color-signal-ink)]">W</span>
				<span class="font-serif text-xl">WorldTime</span>
			</a>
			<span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-subtle)]">404 · outside the known clock</span>
		</div>
	</header>

	<main class="px-5 py-20 sm:px-8 lg:py-28">
		<div class="mx-auto max-w-[1500px]">
			<p class="font-mono text-[10px] uppercase tracking-[0.24em] text-[var(--color-signal)]">A missing moment</p>
			<h1 class="mt-5 max-w-5xl font-serif text-[clamp(4rem,10vw,10rem)] leading-[0.82] tracking-[-0.07em]">
				Time moved on.<br /><em class="font-normal text-[var(--color-signal)]">This page did not.</em>
			</h1>
			<p class="mt-9 max-w-xl text-base leading-7 text-[var(--color-muted)]">
				The address may have changed, but the answer you need is probably still here.
			</p>
			<div class="mt-10 flex flex-wrap gap-3">
				<a href="/" class="rounded-full bg-[var(--color-ink)] px-6 py-3 text-sm text-[var(--color-canvas)]">Ask WorldTime</a>
				<a href="/guides" class="rounded-full border border-[var(--color-line)] px-6 py-3 text-sm">Explore time guides</a>
				<a href="/astronomy" class="rounded-full border border-[var(--color-line)] px-6 py-3 text-sm">Sun, Moon and sky time</a>
			</div>
		</div>
	</main>
</BaseLayout>
