---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cities } from '../lib/cities';

const regions = [
	['Universal time', cities.filter((city) => city.zone === 'UTC')],
	['The Americas', cities.filter((city) => city.zone.startsWith('America/') || city.zone === 'Pacific/Honolulu')],
	['Europe', cities.filter((city) => city.zone.startsWith('Europe/'))],
	['Africa', cities.filter((city) => city.zone.startsWith('Africa/'))],
	['Asia and the Gulf', cities.filter((city) => city.zone.startsWith('Asia/'))],
	['Australia and New Zealand', cities.filter((city) => city.zone.startsWith('Australia/') || city.zone === 'Pacific/Auckland')],
] as const;
---

<BaseLayout
	title="World city clocks · WorldTime"
	description="Find the current local time, date, daylight-saving context and useful calling hours for major cities around the world."
	canonical="/cities"
>
	<header class="border-b border-[var(--color-line)] px-5 sm:px-8">
		<div class="mx-auto flex h-20 max-w-[1500px] items-center justify-between">
			<a href="/" class="flex items-center gap-3">
				<span class="grid size-9 place-items-center rounded-full bg-[var(--color-signal)] font-serif text-xl italic text-[var(--color-signal-ink)]">W</span>
				<span class="font-serif text-xl">WorldTime</span>
			</a>
			<a href="/meeting-planner" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)]">Plan a meeting →</a>
		</div>
	</header>

	<main>
		<section class="atlas-hero relative overflow-hidden border-b border-[var(--color-line)] px-5 py-14 sm:px-8 lg:py-20">
			<img src="/world-atlas-bg.webp" alt="" class="pointer-events-none absolute inset-0 size-full object-cover opacity-50" aria-hidden="true" />
			<div class="atlas-wash pointer-events-none absolute inset-0 bg-gradient-to-r from-[#f6f0e4]/95 via-[#f6f0e4]/65 to-transparent" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-[1500px]">
				<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-signal)]">World city clocks</p>
				<h1 class="mt-5 max-w-4xl font-serif text-[clamp(4rem,9vw,8rem)] leading-[0.86] tracking-[-0.06em]">
					Find your place<br /><em class="font-normal text-[var(--color-signal)]">in time.</em>
				</h1>
				<p class="mt-7 max-w-xl text-base leading-7 text-[var(--color-muted)]">
					Current local time, date changes, daylight-saving context and the hours when somebody is likely to answer.
				</p>
			</div>
		</section>

		<div class="mx-auto max-w-[1500px] px-5 py-12 sm:px-8 lg:py-20">
			{regions.map(([label, regionCities]) => (
				<section class="border-t border-[var(--color-line)] py-9 first:border-t-0 first:pt-0">
					<div class="grid gap-6 lg:grid-cols-[0.35fr_1.65fr]">
						<h2 class="font-serif text-3xl tracking-[-0.035em]">{label}</h2>
						<div class="grid gap-x-8 sm:grid-cols-2 xl:grid-cols-3">
							{regionCities.map((city) => (
								<a
									href={`/time/${city.slug}`}
									class="group flex items-center justify-between border-b border-[var(--color-line)] py-4 text-sm"
								>
									<span class="group-hover:text-[var(--color-signal)]">{city.name}</span>
									<span class="font-mono text-[9px] text-[var(--color-subtle)]">{city.country}</span>
								</a>
							))}
						</div>
					</div>
				</section>
			))}
		</div>
	</main>
</BaseLayout>
