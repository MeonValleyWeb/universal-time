---
import BaseLayout from '../layouts/BaseLayout.astro';
import NaturalTime from '../components/NaturalTime';
import PersonalTimeScale from '../components/PersonalTimeScale';
import WorldStrip from '../components/WorldStrip';
import { cities } from '../lib/cities';

const initialNow = Date.now();
const homepageCitySlugs = [
	'utc', 'london', 'new-york', 'los-angeles',
	'toronto', 'mexico-city', 'sao-paulo', 'paris',
	'cairo', 'dubai', 'delhi', 'singapore',
	'tokyo', 'sydney', 'auckland', 'honolulu',
];
const homepageCities = homepageCitySlugs.map((slug) => cities.find((city) => city.slug === slug)!);
---

<BaseLayout>
	<header class="border-b border-stone-300 px-5 sm:px-8">
		<div class="mx-auto flex h-20 max-w-[1500px] items-center justify-between">
			<a href="/" class="flex items-center gap-3">
				<span class="grid size-9 place-items-center rounded-full bg-orange-600 font-serif text-xl italic text-white">W</span>
				<span class="font-serif text-xl tracking-[-0.03em]">WorldTime</span>
			</a>
			<nav class="flex items-center gap-5 text-sm text-stone-600">
				<a href="#world-clocks" class="hidden hover:text-stone-950 sm:block">World clocks</a>
				<a href="/meeting-planner" class="hidden hover:text-stone-950 sm:block">Meeting planner</a>
				<a href="/astronomy" class="hidden hover:text-stone-950 lg:block">Sun & Moon</a>
				<a href="/guides" class="hidden hover:text-stone-950 lg:block">Time guides</a>
				<span class="rounded-full border border-stone-300 px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider">Live · {cities.length} cities</span>
			</nav>
		</div>
	</header>

	<main>
		<section class="atlas-hero relative overflow-hidden border-b border-stone-950/20 px-5 py-8 sm:px-8 sm:py-16 lg:py-20">
			<img src="/world-atlas-bg.webp" alt="" class="pointer-events-none absolute inset-0 size-full object-cover opacity-80" aria-hidden="true" />
			<div class="atlas-wash pointer-events-none absolute inset-0 bg-gradient-to-r from-[#f6f0e4]/95 via-[#f6f0e4]/55 to-transparent" aria-hidden="true"></div>
			<div class="relative mx-auto grid max-w-[1500px] gap-7 sm:gap-12 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16 xl:gap-24">
				<div class="flex flex-col justify-between">
					<div>
						<div class="mb-4 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.22em] text-orange-700 sm:mb-8">
							<span class="h-px w-8 bg-orange-600"></span>
							The world’s clearest clock
						</div>
						<p class="hidden font-serif text-[clamp(3rem,5vw,5.75rem)] leading-none tracking-[-0.065em] sm:block">WorldTime</p>
						<h1 class="max-w-xl font-serif text-[2.85rem] leading-[0.9] tracking-[-0.06em] sm:mt-7 sm:text-[clamp(3.25rem,5.5vw,6.5rem)]">
							The right time, <em class="font-normal text-orange-600">anywhere.</em>
						</h1>
						<p class="mt-4 max-w-md text-sm leading-6 text-stone-600 sm:mt-8 sm:text-base sm:leading-7">
							Ask naturally, paste a time or compare cities. One clear answer, without timezone maths.
						</p>
					</div>
				</div>
				<NaturalTime client:load initialNow={initialNow} />
			</div>
			<div class="relative mx-auto mt-12 max-w-[1500px] lg:mt-16">
				<div class="mb-3 flex items-center justify-between font-mono text-[9px] uppercase tracking-[0.2em] text-stone-600">
					<span>Live around the world</span>
					<span class="hidden sm:inline">Daylight shown in the signal colour</span>
				</div>
				<WorldStrip client:load initialNow={initialNow} />
			</div>
		</section>

		<section id="how-it-works" class="bg-stone-950 px-5 py-20 text-stone-100 sm:px-8 lg:py-28">
			<div class="mx-auto grid max-w-[1500px] gap-14 lg:grid-cols-2">
				<div>
					<h2 class="max-w-xl font-serif text-5xl leading-[0.95] tracking-[-0.05em] sm:text-6xl">
						Built for the moment before you hit send.
					</h2>
				</div>
				<div class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
					{[
						['Understands natural language', 'Write “Friday at 4pm New York in London” just as you would in a message.'],
						['Respects clock changes', 'Future conversions use the correct local offset for that date.'],
						['Checks the hour', 'See immediately whether your proposed time lands inside a normal working day.'],
						['Ready to share', 'Copy a clear dual-time answer or open a dedicated converter.'],
					].map(([heading, copy]) => (
						<article class="border-t border-stone-700 pt-5">
							<h3 class="font-serif text-2xl">{heading}</h3>
							<p class="mt-3 text-sm leading-6 text-stone-400">{copy}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="border-b border-stone-300 bg-[#e8e4dc] px-5 py-16 sm:px-8">
			<div class="mx-auto grid max-w-[1500px] items-end gap-10 lg:grid-cols-[1fr_auto]">
				<div>
					<h2 class="max-w-3xl font-serif text-4xl leading-none tracking-[-0.045em] sm:text-6xl">
						Compare every working day on one timeline.
					</h2>
					<p class="mt-5 max-w-2xl text-base leading-7 text-stone-600">
						Move from a quick answer to the visual meeting planner when several cities, daylight and fairness all matter.
					</p>
				</div>
				<a href="/meeting-planner" class="inline-flex items-center justify-center rounded-full bg-stone-950 px-6 py-3 text-sm font-medium text-white hover:bg-orange-600">
					Open meeting planner →
				</a>
			</div>
		</section>

		<section class="border-b border-[var(--color-line)] px-5 py-16 sm:px-8 lg:py-24">
			<div class="mx-auto max-w-[1500px]">
				<div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-signal)]">Beyond time zones</p>
						<h2 class="mt-4 max-w-xl font-serif text-5xl leading-[0.94] tracking-[-0.05em] sm:text-6xl">
							Everything that keeps, shapes and marks time.
						</h2>
						<p class="mt-5 max-w-lg text-base leading-7 text-[var(--color-muted)]">
							Follow the Sun and Moon, count down to celestial events, or understand the standards and stories behind the clock.
						</p>
					</div>
					<div class="grid gap-px bg-[var(--color-line)] sm:grid-cols-2">
						<a href="/astronomy" class="group min-h-80 bg-[var(--color-surface)] p-7 hover:bg-[var(--color-ink)] hover:text-[var(--color-canvas)] sm:p-9">
							<span class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-signal)]">Sun · Moon · Sky</span>
							<h3 class="mt-20 font-serif text-4xl tracking-[-0.045em]">Your local sky clock</h3>
							<p class="mt-4 text-sm leading-6 text-[var(--color-muted)] group-hover:text-[var(--color-subtle)]">
								Sunrise, sunset, solar noon, moon phase and live countdowns to eclipses and comet-linked meteor showers.
							</p>
							<span class="mt-8 inline-flex text-sm text-[var(--color-signal)]">Explore astronomical time →</span>
						</a>
						<a href="/guides" class="group min-h-80 bg-[var(--color-surface)] p-7 hover:bg-[var(--color-ink)] hover:text-[var(--color-canvas)] sm:p-9">
							<span class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-signal)]">Atomic · Civil · Historic</span>
							<h3 class="mt-20 font-serif text-4xl tracking-[-0.045em]">Why time works this way</h3>
							<p class="mt-4 text-sm leading-6 text-[var(--color-muted)] group-hover:text-[var(--color-subtle)]">
								Atomic clocks, UTC and GMT, US zone abbreviations, leap seconds, calendars and the reason a day has 24 hours.
							</p>
							<span class="mt-8 inline-flex text-sm text-[var(--color-signal)]">Read the time guides →</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<PersonalTimeScale client:load />

		<section id="world-clocks" class="px-5 py-16 sm:px-8">
			<div class="mx-auto max-w-[1500px]">
				<div class="flex flex-wrap items-end justify-between gap-4">
					<h2 class="font-serif text-4xl tracking-[-0.04em]">Find your place</h2>
					<p class="max-w-lg text-sm leading-6 text-stone-600">The world clocks people reach for most, with every other city waiting in the complete index.</p>
				</div>
				<div class="mt-8 grid gap-x-8 border-t border-stone-300 sm:grid-cols-2 lg:grid-cols-4">
					{homepageCities.map((city) => (
						<a href={`/time/${city.slug}`} class="flex items-center justify-between border-b border-stone-300 py-4 text-sm hover:text-orange-700">
							<span>{city.name}</span>
							<span class="font-mono text-[9px] text-stone-500">{city.country}</span>
						</a>
					))}
				</div>
				<a href="/cities" class="mt-8 inline-flex border-b border-stone-950 pb-1 text-sm font-medium hover:border-orange-600 hover:text-orange-700">
					Explore the complete city index →
				</a>
			</div>
		</section>

	</main>
</BaseLayout>
