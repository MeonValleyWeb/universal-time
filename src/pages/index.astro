---
import BaseLayout from '../layouts/BaseLayout.astro';
import NaturalTime from '../components/NaturalTime';
import PersonalTimeScale from '../components/PersonalTimeScale';
import WorldStrip from '../components/WorldStrip';
import SiteHeader from '../components/SiteHeader.astro';
import { cities } from '../lib/cities';

const initialNow = Date.now();
---

<BaseLayout>
	<SiteHeader />

	<main>
		<section class="border-b border-[var(--color-border)] px-4 py-14 sm:px-6 sm:py-16 lg:py-[92px]">
			<div class="mx-auto grid max-w-[1180px] items-center gap-11 lg:grid-cols-[0.94fr_1.06fr] lg:gap-[72px]">
				<div>
					<div>
						<div class="meridian-eyebrow">World time, made clear</div>
						<h1 class="mt-[18px] max-w-[530px] font-serif text-[clamp(3.1rem,6vw,4.875rem)] font-medium leading-[0.96] tracking-[-0.06em]">
							Every hour, in its right place.
						</h1>
						<p class="mt-6 max-w-[470px] text-[19px] leading-[1.55] text-[var(--color-muted)]">
							Ask naturally, paste a time, or compare cities. WorldTime gives you one clear answer without timezone arithmetic.
						</p>
						<div class="mt-10 flex items-center gap-4 text-[13px] text-[var(--color-muted)]"><span class="block w-[34px] border-t border-[var(--color-border)]"></span><span>Accurate time zones. Clear context. No clutter.</span></div>
					</div>
				</div>
				<NaturalTime client:load initialNow={initialNow} />
			</div>
			<div class="mx-auto mt-12 max-w-[1180px] lg:mt-16">
				<div class="mb-3 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.13em] text-[var(--color-muted)]">
					<span>Live around the world</span>
					<span class="hidden sm:inline">Daylight shown in the accent colour</span>
				</div>
				<WorldStrip client:load initialNow={initialNow} />
			</div>
		</section>

		<section id="how-it-works" class="border-b border-[var(--color-border)] bg-[oklch(0.15_0.027_255)] px-4 py-16 sm:px-6 lg:py-24">
			<div class="mx-auto max-w-[1180px]">
				<div>
					<p class="meridian-eyebrow">Made for the details</p>
					<h2 class="mt-4 max-w-[660px] font-serif text-[clamp(2.25rem,4vw,3.3rem)] font-medium leading-[1.04] tracking-[-0.05em]">
						Confidence belongs in the small print.
					</h2>
				</div>
				<div class="mt-12 grid gap-5 md:grid-cols-3 md:gap-[42px]">
					{[
						['01', 'Daylight-saving, handled.', 'Future conversions use the correct local offset for that date, even when the clocks change.'],
						['02', 'Time with context.', 'Every answer carries its city, zone, relative difference and working-hour context.'],
						['03', 'Ready to share.', 'Copy a clear dual-time answer or open the full planner when more cities matter.'],
					].map(([number, heading, copy]) => (
						<article class="border-t border-[var(--color-border)] pt-4">
							<span class="font-mono text-xs font-bold text-[var(--color-accent)]">{number}</span>
							<h3 class="mt-6 font-serif text-[26px] font-medium leading-[1.05] tracking-[-0.04em]">{heading}</h3>
							<p class="mt-3 text-[15px] leading-6 text-[var(--color-muted)]">{copy}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="border-b border-[var(--color-border)] px-4 py-16 sm:px-6 lg:py-20">
			<div class="mx-auto grid max-w-[1180px] items-end gap-10 lg:grid-cols-[1fr_auto]">
				<div>
					<p class="font-mono text-[10px] uppercase tracking-[0.2em] text-orange-700">Need the whole picture?</p>
					<h2 class="mt-3 max-w-3xl font-serif text-4xl leading-none tracking-[-0.045em] sm:text-6xl">
						Compare every working day on one timeline.
					</h2>
					<p class="mt-5 max-w-2xl text-base leading-7 text-stone-600">
						Move from a quick answer to the visual meeting planner when several cities, daylight and fairness all matter.
					</p>
				</div>
				<a href="/meeting-planner" class="inline-flex min-h-11 items-center justify-center rounded-[var(--radius-button)] border border-[var(--color-accent)] bg-[var(--color-accent)] px-6 text-sm font-semibold text-[var(--color-signal-ink)] hover:-translate-y-px hover:brightness-110">
					Open meeting planner →
				</a>
			</div>
		</section>

		<section class="border-b border-[var(--color-line)] px-5 py-16 sm:px-8 lg:py-24">
			<div class="mx-auto max-w-[1180px]">
				<div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-signal)]">Beyond time zones</p>
						<h2 class="mt-4 max-w-xl font-serif text-5xl leading-[0.94] tracking-[-0.05em] sm:text-6xl">
							Everything that keeps, shapes and marks time.
						</h2>
						<p class="mt-5 max-w-lg text-base leading-7 text-[var(--color-muted)]">
							Follow the Sun and Moon, count down to celestial events, or understand the standards and stories behind the clock.
						</p>
					</div>
					<div class="grid gap-px bg-[var(--color-line)] sm:grid-cols-2">
						<a href="/astronomy" class="group min-h-80 bg-[var(--color-surface)] p-7 hover:bg-[var(--color-ink)] hover:text-[var(--color-canvas)] sm:p-9">
							<span class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-signal)]">Sun · Moon · Sky</span>
							<h3 class="mt-20 font-serif text-4xl tracking-[-0.045em]">Your local sky clock</h3>
							<p class="mt-4 text-sm leading-6 text-[var(--color-muted)] group-hover:text-[var(--color-subtle)]">
								Sunrise, sunset, solar noon, moon phase and live countdowns to eclipses and comet-linked meteor showers.
							</p>
							<span class="mt-8 inline-flex text-sm text-[var(--color-signal)]">Explore astronomical time →</span>
						</a>
						<a href="/guides" class="group min-h-80 bg-[var(--color-surface)] p-7 hover:bg-[var(--color-ink)] hover:text-[var(--color-canvas)] sm:p-9">
							<span class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-signal)]">Atomic · Civil · Historic</span>
							<h3 class="mt-20 font-serif text-4xl tracking-[-0.045em]">Why time works this way</h3>
							<p class="mt-4 text-sm leading-6 text-[var(--color-muted)] group-hover:text-[var(--color-subtle)]">
								Atomic clocks, UTC and GMT, US zone abbreviations, leap seconds, calendars and the reason a day has 24 hours.
							</p>
							<span class="mt-8 inline-flex text-sm text-[var(--color-signal)]">Read the time guides →</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<PersonalTimeScale client:load />

		<section id="world-clocks" class="px-5 py-16 sm:px-8">
			<div class="mx-auto max-w-[1180px]">
				<p class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500">Popular city clocks</p>
				<h2 class="mt-2 font-serif text-3xl tracking-[-0.04em]">Find your place</h2>
				<div class="mt-8 grid gap-x-8 border-t border-stone-300 sm:grid-cols-2 lg:grid-cols-4">
					{cities.map((city) => (
						<a href={`/time/${city.slug}`} class="flex items-center justify-between border-b border-stone-300 py-4 text-sm hover:text-orange-700">
							<span>{city.name}</span>
							<span class="font-mono text-[9px] text-stone-500">{city.country}</span>
						</a>
					))}
				</div>
			</div>
		</section>

	</main>
</BaseLayout>
