---
import BaseLayout from '../layouts/BaseLayout.astro';
import NaturalTime from '../components/NaturalTime';
import PersonalTimeScale from '../components/PersonalTimeScale';
import WorldStrip from '../components/WorldStrip';
import { cities } from '../lib/cities';

const initialNow = Date.now();
const homepageCitySlugs = [
	'utc', 'london', 'new-york', 'los-angeles',
	'toronto', 'mexico-city', 'sao-paulo', 'paris',
	'cairo', 'dubai', 'delhi', 'singapore',
	'tokyo', 'sydney', 'auckland', 'honolulu',
];
const homepageCities = homepageCitySlugs.map((slug) => cities.find((city) => city.slug === slug)!);
---

<BaseLayout>
	<header class="relative z-20 border-b border-[var(--color-line)] px-5 sm:px-8">
		<div class="mx-auto flex h-[72px] max-w-[1500px] items-center justify-between">
			<a href="/" class="flex items-center gap-3">
				<span class="grid size-9 place-items-center rounded-full bg-[var(--color-signal)] font-serif text-xl italic text-[var(--color-signal-ink)]">W</span>
				<span class="font-serif text-xl tracking-[-0.03em]">WorldTime</span>
			</a>
			<nav class="flex items-center gap-4 text-sm text-[var(--color-muted)] sm:gap-7">
				<a href="#world-clocks" class="hidden hover:text-[var(--color-ink)] sm:block">World clocks</a>
				<a href="/astronomy" class="hidden hover:text-[var(--color-ink)] md:block">Sun & Moon</a>
				<a href="/guides" class="hidden hover:text-[var(--color-ink)] lg:block">Time guides</a>
				<a href="/meeting-planner" class="border-b border-[var(--color-ink)] pb-1 text-[var(--color-ink)] hover:border-[var(--color-signal)] hover:text-[var(--color-signal)]">
					Plan a meeting
				</a>
			</nav>
		</div>
	</header>

	<main>
		<section class="atlas-hero relative overflow-hidden border-b border-[var(--color-line)] px-5 py-8 sm:px-8 lg:min-h-[calc(100dvh-72px)] lg:py-10">
			<img src="/world-atlas-bg.webp" alt="" class="pointer-events-none absolute inset-0 size-full object-cover opacity-55" aria-hidden="true" />
			<div class="atlas-wash pointer-events-none absolute inset-0 bg-gradient-to-r from-[#f6f0e4]/95 via-[#f6f0e4]/68 to-[#f6f0e4]/28" aria-hidden="true"></div>

			<div class="relative mx-auto max-w-[1500px]">
				<div class="mb-8 grid items-end gap-5 sm:mb-10 lg:grid-cols-[1fr_auto]">
					<div>
						<p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-signal)]">The world’s clearest clock</p>
						<h1 class="mt-3 font-serif text-[clamp(4.5rem,12vw,11rem)] leading-[0.72] tracking-[-0.07em]">WorldTime</h1>
					</div>
					<p class="max-w-sm pb-1 font-serif text-3xl leading-[0.95] tracking-[-0.035em] sm:text-4xl lg:text-right">
						The right time,<br /><em class="font-normal text-[var(--color-signal)]">anywhere.</em>
					</p>
				</div>

				<NaturalTime client:load initialNow={initialNow} />

				<div class="mt-5">
					<WorldStrip client:load initialNow={initialNow} />
				</div>
			</div>
		</section>

		<section id="how-it-works" class="border-b border-[var(--color-line)] px-5 py-20 sm:px-8 lg:py-28">
			<div class="mx-auto max-w-[1500px]">
				<div class="max-w-5xl">
					<h2 class="font-serif text-5xl leading-[0.9] tracking-[-0.05em] sm:text-7xl lg:text-8xl">
						Say it the way you would to a person.
					</h2>
					<p class="mt-7 max-w-2xl text-lg leading-8 text-[var(--color-muted)]">
						Ask about a call, a journey or a future date. WorldTime handles the clock changes and gives you one direct answer.
					</p>
				</div>

				<div class="mt-16 grid border-t border-[var(--color-line)] md:grid-cols-[1.3fr_0.7fr]">
					<div class="border-b border-[var(--color-line)] py-9 md:border-b-0 md:border-r md:pr-12">
						<p class="font-serif text-4xl leading-tight">“When should I ring Auckland before I go to bed?”</p>
						<p class="mt-5 max-w-xl text-base leading-7 text-[var(--color-muted)]">The answer is returned in your browser’s local time, with Auckland’s date and hour beside it.</p>
					</div>
					<div class="grid divide-y divide-[var(--color-line)] md:pl-10">
						<div class="py-7">
							<p class="font-serif text-2xl">Future dates stay correct</p>
							<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Daylight-saving changes are calculated for the date you asked about.</p>
						</div>
						<div class="py-7">
							<p class="font-serif text-2xl">Useful hours are visible</p>
							<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">You can see when an answer lands in somebody else’s day.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="meeting-field relative overflow-hidden border-b border-[var(--color-line)] px-5 py-20 sm:px-8 lg:py-28">
			<img src="/world-atlas-bg.webp" alt="" class="pointer-events-none absolute inset-0 size-full object-cover opacity-20" aria-hidden="true" />
			<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[var(--color-canvas)] via-[var(--color-canvas)]/92 to-transparent" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-[1500px]">
				<h2 class="max-w-4xl font-serif text-6xl leading-[0.86] tracking-[-0.055em] sm:text-8xl">
					When two cities become six.
				</h2>
				<p class="mt-7 max-w-xl text-lg leading-8 text-[var(--color-muted)]">
					Move every city across one 48-hour timeline and find the fairest meeting window.
				</p>
				<a href="/meeting-planner" class="mt-10 inline-flex bg-[var(--color-ink)] px-6 py-3 text-sm font-medium text-[var(--color-canvas)] hover:bg-[var(--color-signal)] hover:text-[var(--color-signal-ink)]">
					Open the meeting planner →
				</a>
			</div>
		</section>

		<section class="border-b border-[var(--color-line)] px-5 py-20 sm:px-8 lg:py-28">
			<div class="mx-auto max-w-[1500px]">
				<h2 class="max-w-4xl font-serif text-5xl leading-[0.92] tracking-[-0.05em] sm:text-7xl">
					Time does not stop at time zones.
				</h2>
				<div class="mt-14 border-t border-[var(--color-line)]">
					<a href="/astronomy" class="group grid gap-6 border-b border-[var(--color-line)] py-9 md:grid-cols-[0.85fr_1.15fr] md:items-baseline">
						<h3 class="font-serif text-4xl tracking-[-0.04em] group-hover:text-[var(--color-signal)] sm:text-5xl">The sky clock</h3>
						<div>
							<p class="max-w-xl text-base leading-7 text-[var(--color-muted)]">Sunrise, sunset, lunar phase and live countdowns to eclipses and meteor showers.</p>
							<span class="mt-4 inline-flex text-sm text-[var(--color-signal)]">Explore Sun, Moon and sky →</span>
						</div>
					</a>
					<a href="/guides" class="group grid gap-6 border-b border-[var(--color-line)] py-9 md:grid-cols-[0.85fr_1.15fr] md:items-baseline">
						<h3 class="font-serif text-4xl tracking-[-0.04em] group-hover:text-[var(--color-signal)] sm:text-5xl">Why the clock works</h3>
						<div>
							<p class="max-w-xl text-base leading-7 text-[var(--color-muted)]">Atomic clocks, UTC, daylight saving, calendars and the long history of measuring a day.</p>
							<span class="mt-4 inline-flex text-sm text-[var(--color-signal)]">Read the time guides →</span>
						</div>
					</a>
				</div>
			</div>
		</section>

		<PersonalTimeScale client:load />

		<section id="world-clocks" class="border-b border-[var(--color-line)] px-5 py-20 sm:px-8 lg:py-28">
			<div class="mx-auto max-w-[1500px]">
				<h2 class="font-serif text-6xl leading-none tracking-[-0.05em] sm:text-8xl">Find your place.</h2>
				<p class="mt-5 max-w-xl text-base leading-7 text-[var(--color-muted)]">Start with the clocks people use most, or open the complete world city index.</p>
				<div class="mt-12 grid border-l border-t border-[var(--color-line)] sm:grid-cols-2 lg:grid-cols-4">
					{homepageCities.map((city) => (
						<a href={`/time/${city.slug}`} class="group min-h-28 border-b border-r border-[var(--color-line)] p-5 hover:bg-[var(--color-surface)]">
							<span class="font-serif text-2xl group-hover:text-[var(--color-signal)]">{city.name}</span>
							<span class="mt-5 block font-mono text-[9px] uppercase tracking-[0.12em] text-[var(--color-subtle)]">{city.country}</span>
						</a>
					))}
				</div>
				<a href="/cities" class="mt-8 inline-flex border-b border-[var(--color-ink)] pb-1 text-sm font-medium hover:border-[var(--color-signal)] hover:text-[var(--color-signal)]">
					Open the complete city index →
				</a>
			</div>
		</section>
	</main>
</BaseLayout>
