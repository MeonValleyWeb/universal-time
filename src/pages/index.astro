---
import BaseLayout from '../layouts/BaseLayout.astro';
import NaturalTime from '../components/NaturalTime';
import PersonalTimeScale from '../components/PersonalTimeScale';
import WorldStrip from '../components/WorldStrip';
import { cities } from '../lib/cities';
import { formatOffset, getOffsetMinutes } from '../lib/time';

const initialNow = Date.now();
const citiesByOffset = cities.reduce((groups, city) => {
	const offset = getOffsetMinutes(initialNow, city.zone);
	groups.set(offset, [...(groups.get(offset) ?? []), city]);
	return groups;
}, new Map<number, typeof cities>());
const clockGroups = [...citiesByOffset.entries()]
	.sort(([leftOffset], [rightOffset]) => leftOffset - rightOffset)
	.map(([offset, groupedCities]) => ({
		label: offset === 0 ? 'UTC / GMT' : formatOffset(offset),
		cities: [...groupedCities].sort((left, right) => left.name.localeCompare(right.name)),
	}));
---

<BaseLayout
	title="World Time Converter, Meeting Planner & City Clocks · WorldTime"
	description="Convert time between cities, find a fair meeting window, and check live world clocks with daylight-saving context."
	canonical="/"
>
	<main>
		<section class="border-b border-[var(--color-border)] px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:pt-20">
			<div class="mx-auto grid max-w-[1180px] items-start gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-center lg:gap-14">
				<div class="max-w-xl">
					<p class="text-sm font-medium text-[var(--color-accent)]">WorldTime</p>
					<h1 class="mt-4 font-serif text-[clamp(2.75rem,5vw,4.5rem)] font-medium leading-[0.98] tracking-[-0.045em]">
						Time zones, made clear.
					</h1>
					<p class="mt-5 max-w-md text-base leading-7 text-[var(--color-muted)] sm:text-lg">
						Check the local time, convert a date, or find a meeting time that works across cities.
					</p>
					<a href="/meeting-planner" class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-[var(--color-fg)] underline decoration-[var(--color-accent)] underline-offset-4 hover:text-[var(--color-accent)]">
						Open the meeting planner <span aria-hidden="true">→</span>
					</a>
				</div>
				<NaturalTime client:load initialNow={initialNow} />
			</div>

			<div class="mx-auto mt-12 max-w-[1180px] lg:mt-16">
				<div class="mb-3 flex items-center justify-between gap-4 text-xs text-[var(--color-muted)]">
					<h2 class="font-medium text-[var(--color-fg)]">Current time in six cities</h2>
					<span class="hidden sm:inline">Select a city for local details</span>
				</div>
				<WorldStrip client:load initialNow={initialNow} />
			</div>
		</section>

		<section class="border-b border-[var(--color-border)] px-4 py-12 sm:px-6 lg:py-16">
			<div class="mx-auto grid max-w-[1180px] gap-8 rounded-[var(--radius-panel)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12">
				<div class="max-w-2xl">
					<p class="text-sm font-medium text-[var(--color-accent)]">Meeting planner</p>
					<h2 class="mt-2 font-serif text-3xl tracking-[-0.035em] sm:text-4xl">Find a time that works for everyone.</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)] sm:text-base">Compare working hours across cities and choose a meeting window with the local dates and daylight-saving changes accounted for.</p>
				</div>
				<a href="/meeting-planner" class="inline-flex min-h-11 items-center justify-center gap-3 self-start rounded-[var(--radius-button)] bg-[var(--color-accent)] px-5 text-sm font-medium text-[var(--color-signal-ink)] hover:brightness-110 lg:self-center">
					Plan a meeting <span aria-hidden="true">→</span>
				</a>
			</div>
		</section>

		<section id="how-it-works" class="border-b border-[var(--color-border)] px-4 py-14 sm:px-6 lg:py-20">
			<div class="mx-auto max-w-[1180px]">
				<div class="max-w-2xl">
					<p class="text-sm font-medium text-[var(--color-accent)]">Reliable by date and place</p>
					<h2 class="mt-3 font-serif text-3xl font-medium tracking-[-0.04em] sm:text-4xl">The details are handled.</h2>
				</div>
				<div class="mt-9 grid gap-7 md:grid-cols-3 md:gap-10">
					{[
						['01', 'Daylight-saving changes', 'Conversions use the local offset for the date you choose, including seasonal clock changes.'],
						['02', 'Local context', 'See the city, time-zone abbreviation and date alongside each result.'],
						['03', 'Easy to share', 'Copy a conversion or share a query with the people you are planning with.'],
					].map(([number, heading, copy]) => (
						<article class="border-t border-[var(--color-border)] pt-4">
							<span class="text-xs tabular-nums text-[var(--color-subtle)]">{number}</span>
							<h3 class="mt-4 text-base font-medium">{heading}</h3>
							<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{copy}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="border-b border-[var(--color-border)] px-4 py-14 sm:px-6 lg:py-20">
			<div class="mx-auto grid max-w-[1180px] gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:gap-14">
				<div>
					<p class="text-sm font-medium text-[var(--color-accent)]">More to explore</p>
					<h2 class="mt-3 max-w-md font-serif text-3xl font-medium leading-tight tracking-[-0.04em] sm:text-4xl">Time connects to more than the clock.</h2>
					<p class="mt-4 max-w-md text-sm leading-6 text-[var(--color-muted)]">Explore the local sky or learn how the standards behind everyday timekeeping work.</p>
				</div>
				<div class="grid gap-3 sm:grid-cols-2">
					<a href="/astronomy" class="group rounded-[var(--radius-control)] border border-[var(--color-border)] p-5 transition-colors hover:bg-[var(--color-surface)] sm:p-6">
						<h3 class="font-medium">Sun, Moon and sky</h3>
						<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Sunrise, sunset, moon phase and upcoming celestial events for your city.</p>
						<span class="mt-5 inline-flex items-center gap-2 text-sm text-[var(--color-accent)]">Explore astronomy <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
					</a>
					<a href="/guides" class="group rounded-[var(--radius-control)] border border-[var(--color-border)] p-5 transition-colors hover:bg-[var(--color-surface)] sm:p-6">
						<h3 class="font-medium">Time guides</h3>
						<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Clear explanations of UTC, GMT, time-zone abbreviations and calendars.</p>
						<span class="mt-5 inline-flex items-center gap-2 text-sm text-[var(--color-accent)]">Read the guides <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
					</a>
				</div>
			</div>
		</section>

		<PersonalTimeScale client:load />

		<section id="world-clocks" class="px-4 py-14 sm:px-6 lg:py-20">
			<div class="mx-auto max-w-[1180px]">
				<p class="text-sm font-medium text-[var(--color-accent)]">Browse by time zone</p>
				<h2 class="mt-2 font-serif text-3xl font-medium tracking-[-0.04em]">Local times around the world</h2>
				<p class="mt-3 max-w-2xl text-sm leading-6 text-[var(--color-muted)]">Cities are grouped by their current UTC offset. Seasonal clock changes can move a city to a different group.</p>
				<div class="mt-8 grid gap-x-8 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
					{clockGroups.map((group) => (
						<section class="border-t border-[var(--color-border)] pt-4" aria-label={`${group.label} city clocks`}>
							<div class="flex items-baseline justify-between gap-3">
								<h3 class="text-sm font-medium text-[var(--color-accent)]">{group.label}</h3>
								<span class="text-xs text-[var(--color-subtle)]">{group.cities.length} {group.cities.length === 1 ? 'place' : 'places'}</span>
							</div>
							<div class="mt-2">
								{group.cities.map((city) => (
									<a href={`/time/${city.slug}`} class="flex items-center justify-between gap-3 border-b border-[var(--color-border)] py-3 text-sm text-[var(--color-fg)] hover:text-[var(--color-accent)]">
										<span>{city.name}</span>
										<span class="shrink-0 text-xs text-[var(--color-subtle)]">{city.country}</span>
									</a>
								))}
							</div>
						</section>
					))}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
